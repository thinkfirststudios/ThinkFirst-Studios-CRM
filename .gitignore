# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Node (only if tooling is added later)
node_modules/
npm-debug.log*

# Local backups exported from the Admin panel
*-backup-*.json
thinkfirst-*.csv

# Secrets — never commit
.env
.env.*
credentials.json
token.json

# Screenshots dropped for lead extraction — never committed
.tmp/

# Lead lists dropped anywhere in the tree. These hold contact details for
# real people who did not consent to being in a public repo - same reason
# .tmp/ is ignored. Keep working copies in .tmp/leads/.
*.pdf
*contact*list*
*Contact*List*

# ...but not the code that reads them. This repo is on Windows, where git
# matches ignore rules without regard to case, so "*contact*list*" quietly
# swallowed tools/prep-contact-list.py: it was written, used, and described
# in a commit message that did not contain it. The tools hold no contact
# details, only the rules for handling them.
!tools/*.py
!tools/*.mjs

# Local database backups taken with tools/backup.mjs. Kept OUT of .tmp/
# because .tmp/ is disposable by convention and these are not.
backups/

# Lead lists waiting on somebody to import them. Real contact details,
# and not disposable the way .tmp/ is.
standby/*
!standby/README.md

# Python bytecode cache
__pycache__/
*.pyc
